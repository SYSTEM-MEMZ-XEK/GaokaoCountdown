<ui:FAAppWindow x:Class="StudyJourney.Avalonia.Views.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        Title="学程 · 设置"
        Width="920" Height="660"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica"
        Background="Transparent">

    <!--
        WinUI 3 风格设置窗口（对齐学程原版 6 个 Tab）：
        - 保留系统装饰（三大金刚键 + Win11 系统圆角，ClassIsland 同款）
        - Mica 材质 + FANavigationView 左侧导航（带图标）
    -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0" Text="设置"
                   FontSize="24" FontWeight="SemiBold"
                   Margin="24,16,0,8"/>

        <ui:FANavigationView Grid.Row="1"
                             x:Name="NavView"
                             PaneDisplayMode="Left"
                             OpenPaneLength="220"
                             IsSettingsVisible="False"
                             IsBackButtonVisible="False"
                             ItemInvoked="NavView_ItemInvoked">
            <ui:FANavigationView.MenuItems>
                <ui:FANavigationViewItem Content="倒计时" Tag="countdown">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Home"/>
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="位置" Tag="position">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="MapPin"/>
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="API 功能" Tag="api">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Cloud"/>
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="课表" Tag="schedule">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Calendar"/>
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="考试" Tag="exam">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Clock"/>
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="服务器" Tag="server">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Globe"/>
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="自动化" Tag="automation">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Play"/>
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="关于" Tag="about">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="Help"/>
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
            </ui:FANavigationView.MenuItems>

            <!-- 页面内容区 -->
            <Border x:Name="PageHost" Margin="8,0,0,0"/>
        </ui:FANavigationView>

        <!-- 底部操作条 -->
        <Border Grid.Row="2" Padding="20,10" Background="#0AFFFFFF"
                BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <CheckBox x:Name="PageAnimationsCheck" Content="页面动画" IsChecked="True"
                          VerticalAlignment="Center" ToolTip.Tip="切换设置页时的淡入动画"/>
                <TextBlock Grid.Column="1" Text="修改后点击「保存」生效，保存到 settings.json（与 WPF 版共用）"
                           FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Grid.Column="2" Content="恢复默认" Margin="0,0,8,0" Click="ResetBtn_Click"/>
                <Button Grid.Column="3" Content="取消" Margin="0,0,8,0" Click="CancelBtn_Click"/>
                <Button Grid.Column="4" Content="保存设置" Classes="accent" Click="SaveBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</ui:FAAppWindow>
